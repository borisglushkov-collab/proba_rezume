\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1054 \uc0\u1073 \uc0\u1086  \uc0\u1084 \uc0\u1085 \uc0\u1077 }\cell
\pard\intbl\itap1\sb250\sl260{\fs18 \uc0\u1058 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1073 \uc0\u1072 \uc0\u1085 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1082 \uc0\u1072 \uc0\u1088 \uc0\u1090 , 20+ \uc0\u1083 \uc0\u1077 \uc0\u1090  \uc0\u1074  \uc0\u1073 \uc0\u1072 \uc0\u1085 \uc0\u1082 \uc0\u1072 \uc0\u1093 , \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1077  \uc0\u1080  \uc0\u1073 \uc0\u1102 \uc0\u1088 \uc0\u1086  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 . \uc0\u1057 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 : EMV, \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1105 \uc0\u1078 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1072  \uc0\u1052 \uc0\u1048 \uc0\u1056 , HSM, Way4/OpenWay, Datacard. \uc0\u1057 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1080 \uc0\u1092 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1082 \uc0\u1072 \uc0\u1088 \uc0\u1090  \uc0\u1074  \uc0\u1052 \uc0\u1055 \uc0\u1057  \uc0\u1080  \uc0\u1053 \uc0\u1057 \uc0\u1055 \uc0\u1050 , \uc0\u1082 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1077 \uc0\u1074 \uc0\u1072 \uc0\u1103  \uc0\u1094 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1103 , \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1089 \uc0\u1086 \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1078 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1086 -\uc0\u1073 \uc0\u1102 \uc0\u1088 \uc0\u1086 , \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1072  \uc0\u1088 \uc0\u1077 \uc0\u1075 \uc0\u1083 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1058 \uc0\u1047 .{\line}{\line}\uc0\u1042 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1072  \uc0\u1082 \uc0\u1072 \uc0\u1090 . B, \uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1073 \uc0\u1080 \uc0\u1083 \uc0\u1100 . \uc0\u1043 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1082  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072 \uc0\u1084 .{\line}\uc0\u1054 \uc0\u1087 \uc0\u1099 \uc0\u1090 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100  Windows, MS Office. \uc0\u1041 \uc0\u1072 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1077  SQL-\uc0\u1079 \uc0\u1072 \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1099  \uc0\u1082  Way4Cards.}\cell\row



